// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model for customer inquiries & property leads
model Lead {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  city      String?
  budget    String?
  project   String?
  address   String?
  message   String?
  source    String   @default("website") // e.g. "contact_page", "interest_section", "price_list"
  status    String   @default("NEW")     // "NEW", "CONTACTED", "FOLLOW_UP", "CONVERTED", "CLOSED"
  // Legacy technical metadata. New leads no longer populate these three columns.
  ipAddress String?
  country   String?
  userAgent String?
  noticeVersion        String?
  noticeLanguage       String?
  marketingConsent     Boolean   @default(false)
  marketingConsentAt   DateTime?
  marketingWithdrawnAt DateTime?
  // The advert or campaign behind the visit. Saved only if the visitor allowed advertising.
  adChannel     String?
  adUtmSource   String?
  adUtmMedium   String?
  adUtmCampaign String?
  legalHoldReason      String? // Set only for a documented legal retention exception
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([phone])
  @@index([email])
}

// Model for job vacancies/postings created by Admin
model JobVacancy {
  id           String   @id @default(cuid())
  title        String
  department   String?
  location     String   @default("Ranchi, JH")
  type         String   @default("Full - Time")
  description  String
  requirements String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

// Model for job applications from Career page
model JobApplication {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  jobTitle    String
  experience  String?
  coverLetter String?
  resumePath  String?  // local file path or cloud URL to downloaded resume
  status      String   @default("SUBMITTED") // "SUBMITTED", "REVIEWED", "SHORTLISTED", "REJECTED"
  noticeVersion   String?
  noticeLanguage  String?
  legalHoldReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([jobTitle])
  @@index([email])
  @@index([phone])
}

// Model for future AI Chatbot conversations & session logs
model ChatSession {
  id        String        @id @default(cuid())
  userId    String?       // optional anonymous ID or registered user ID
  title     String?       @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String      // "user" | "assistant" | "system"
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}



// Update your existing BlogPost model to include the comments array
model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  category    String    @default("Uncategorized")
  excerpt     String?
  content     String
  imagePath   String?
  imageAlt    String?
  metaTitle   String?
  metaDesc    String?
  keywords    String?
  author      String?   @default("Vastu Vihar")
  readingTime String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[] 

  @@index([createdAt])
  @@index([slug])
}

// Add the new Comment model at the bottom of the file
model Comment {
  id          String   @id @default(cuid())
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  authorName  String
  authorEmail String?
  content     String
  isApproved  Boolean  @default(false) // Comments are published only after moderation
  noticeVersion  String?
  noticeLanguage String?
  createdAt   DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
  @@index([authorEmail])
}

// ---------------------------------------------------------------------------
// DPDP Act 2023: consent, rights requests, breach, retention and admin controls
// ---------------------------------------------------------------------------

// Append-only consent ledger. Contact details are stored only as keyed hashes,
// so proof of consent can outlive erasure of the underlying enquiry.
model ConsentRecord {
  id            String   @id @default(cuid())
  phoneKey      String?
  emailKey      String?
  browserKey    String?
  recordType    String? // "lead" | "application" | "comment" | "newsletter" | "browser"
  recordId      String?
  purpose       String // see lib/privacy/notices
  action        String // "GRANTED" | "WITHDRAWN"
  noticeVersion String
  language      String   @default("en")
  source        String
  createdAt     DateTime @default(now())

  @@index([phoneKey])
  @@index([emailKey])
  @@index([browserKey])
  @@index([purpose])
  @@index([createdAt])
}

// What happened in a browser after its visitor allowed analytics or advertising.
// Holds a keyed hash of the browser ID, never contact details, IP addresses or cookie
// values. A category's rows are deleted when the visitor withdraws that category.
model VisitorEvent {
  id            String   @id @default(cuid())
  browserKey    String
  kind          String // "page_view" | "tag_event"
  category      String // "analytics" | "advertising"
  path          String?
  cookies       String? // Comma-separated cookie names, on page views
  adChannel     String? // "google_ads" | "meta" | "campaign", on advertising page views
  adUtmSource   String?
  adUtmMedium   String?
  adUtmCampaign String?
  provider      String? // "google_tag" | "google_analytics" | "google_ads" | "meta_pixel", on tag events
  eventName     String? // On tag events
  noticeVersion String
  createdAt     DateTime @default(now())

  @@index([browserKey])
  @@index([kind])
  @@index([adChannel])
  @@index([createdAt])
}

// The newsletter list. Proof of each sign-up and opt-out is in ConsentRecord.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("SUBSCRIBED") // "SUBSCRIBED" | "UNSUBSCRIBED"
  noticeVersion  String
  noticeLanguage String    @default("en")
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

// Keeps an opt-out effective across later imports or systems. Keyed hash only.
model MarketingSuppression {
  key       String   @id
  source    String
  createdAt DateTime @default(now())
}

model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([bucket, keyHash, createdAt])
  @@index([createdAt])
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String // see lib/adminAuth ROLE_PERMISSIONS
  isActive     Boolean        @default(true)
  failedLogins Int            @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Never put personal data in metadata: identifiers and field names only.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
}

// Access, correction, erasure, consent withdrawal, nomination and grievances.
model PrivacyRequest {
  id              String    @id @default(cuid())
  ticketNo        String    @unique
  type            String // "ACCESS" | "CORRECTION" | "ERASURE" | "CONSENT_WITHDRAWAL" | "NOMINATION" | "GRIEVANCE"
  category        String?
  requesterName   String
  email           String?
  phone           String?
  details         String
  requestedChange String? // JSON for correction requests
  nomineeName     String?
  nomineeContact  String?
  nomineeRelation String?
  actingAs        String    @default("SELF") // "SELF" | "NOMINEE"
  language        String    @default("en")
  status          String    @default("RECEIVED") // "RECEIVED" | "VERIFYING" | "IN_PROGRESS" | "ESCALATED" | "RESOLVED" | "REJECTED"
  verifiedAt      DateTime?
  verifiedBy      String?
  verifyMethod    String?
  verifiedChannels String? // Comma-separated: which of "email" and "phone" were confirmed
  outcome         String?
  retentionNote   String?
  dueAt           DateTime
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  events          PrivacyRequestEvent[]

  @@index([status])
  @@index([type])
  @@index([dueAt])
  @@index([createdAt])
}

model PrivacyRequestEvent {
  id         String         @id @default(cuid())
  requestId  String
  actorEmail String?
  action     String
  note       String?
  createdAt  DateTime       @default(now())
  request    PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model BreachIncident {
  id                      String    @id @default(cuid())
  reference               String    @unique
  title                   String
  status                  String    @default("DETECTED") // "DETECTED" | "ASSESSING" | "CONTAINED" | "NOTIFIED" | "CLOSED"
  severity                String    @default("UNASSESSED")
  detectedAt              DateTime
  occurredAt              DateTime?
  nature                  String?
  scope                   String?
  affectedDataTypes       String?
  affectedCount           Int?
  containmentActions      String?
  remediationActions      String?
  likelyConsequences      String?
  ownerEmail              String?
  boardDueAt              DateTime?
  boardIntimatedAt        DateTime?
  boardReportedAt         DateTime?
  boardReference          String?
  principalsNotifiedAt    DateTime?
  principalsNotifiedCount Int?
  notificationNotes       String?
  createdBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([status])
  @@index([detectedAt])
}

// retentionDays stays null until the organisation approves a period. A null
// period means the job never deletes that category.
model RetentionPolicy {
  category      String    @id
  description   String
  retentionDays Int?
  action        String    @default("DELETE")
  legalBasis    String?
  approvedBy    String?
  approvedAt    DateTime?
  updatedAt     DateTime  @updatedAt
}

model RetentionLog {
  id        String   @id @default(cuid())
  runId     String
  category  String
  action    String
  affected  Int
  dryRun    Boolean
  trigger   String
  note      String?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([createdAt])
}

// One row per admin change to the gallery. Photos in public/gallery need no row.
//   builtInName set, storageKey set:   a built-in photo replaced by an upload
//   builtInName set, storageKey null:  a built-in photo removed
//   builtInName null, storageKey set:  an added photo
model GalleryImage {
  id          String   @id @default(cuid())
  album       String
  builtInName String?
  storageKey  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([album, builtInName])
  @@index([album, createdAt])
}

model PrivacySetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}