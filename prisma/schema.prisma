// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Model for customer inquiries & property leads
model Lead {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  city      String?
  budget    String?
  project   String?
  address   String?
  message   String?
  source    String   @default("website") // e.g. "contact_page", "interest_section", "price_list"
  status    String   @default("NEW")     // "NEW", "CONTACTED", "FOLLOW_UP", "CONVERTED", "CLOSED"
  ipAddress String?
  country   String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([phone])
}

// Model for job vacancies/postings created by Admin
model JobVacancy {
  id           String   @id @default(cuid())
  title        String
  department   String?
  location     String   @default("Ranchi, JH")
  type         String   @default("Full - Time")
  description  String
  requirements String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

// Model for job applications from Career page
model JobApplication {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  jobTitle    String
  experience  String?
  coverLetter String?
  resumePath  String?  // local file path or cloud URL to downloaded resume
  status      String   @default("SUBMITTED") // "SUBMITTED", "REVIEWED", "SHORTLISTED", "REJECTED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([jobTitle])
}

// Model for future AI Chatbot conversations & session logs
model ChatSession {
  id        String        @id @default(cuid())
  userId    String?       // optional anonymous ID or registered user ID
  title     String?       @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String      // "user" | "assistant" | "system"
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
