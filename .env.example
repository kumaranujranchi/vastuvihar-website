# For the Node.js server (AWS Lightsail, Docker, `npm run start`). Never commit real values.
#
# Cloudflare does NOT use .env files: OpenNext would bundle their values into the Worker,
# so scripts/cf.mjs refuses to build for UAT or production while one exists. There:
#   - build-time values are set by scripts/cf.mjs or as CI variables (tag IDs below),
#   - secrets are set with `npx wrangler secret put <NAME> [--env uat]`,
#   - everything else is in wrangler.jsonc. Local Worker runs read .dev.vars
#     (see .dev.vars.example). Full guide: docs/CLOUDFLARE_DEPLOYMENT.md

# Only used by Prisma on Node.js and by Prisma CLI commands. Workers read the D1 binding.
DATABASE_URL="file:./local.db"

NEXT_PUBLIC_SITE_URL="https://vastuvihar.com"

# production (default) or uat. Anything but production is served with noindex and a
# robots.txt that disallows everything.
NEXT_PUBLIC_APP_ENV="production"

# Optional tags. A tag stays off, is never loaded before consent, and is not offered or
# mentioned in the policy, until its ID is set. Read at build time: rebuild after a change.
# Have the policy and notice wording approved before setting any of these in production.
NEXT_PUBLIC_GA4_ID=""                 # Google Analytics, for example G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=""          # Google Ads remarketing, for example AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=""  # Conversion label for a sent enquiry (optional)
NEXT_PUBLIC_META_PIXEL_ID=""          # Meta Pixel, digits only
NEXT_PUBLIC_CLARITY_ID=""             # Microsoft Clarity project ID (lowercase letters and digits)

# Required in production: at least 32 random characters. The server refuses to hash or
# sign anything without it. Keys the consent-ledger hashes and signed admin cookies.
# Changing it breaks the link between old consent records and their contacts, so reuse
# the same value when moving to Cloudflare.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PRIVACY_HASH_SECRET=""

# Required to enable scheduled retention: at least 32 random characters.
RETENTION_CRON_SECRET=""

# Set to 1 only behind a proxy that sends X-Forwarded-Proto. On Cloudflare, leave this unset
# and turn on "Always Use HTTPS" for the domain instead.
FORCE_HTTPS=""

# Built-in master admin login (app/api/admin/auth/route.ts). Kept by request. On Cloudflare
# the admin area is only reachable through Cloudflare Access (REQUIRE_CF_ACCESS=1).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Used once by scripts/create-admin-d1.mjs, then removed from the environment.
ADMIN_BOOTSTRAP_PASSWORD=""
