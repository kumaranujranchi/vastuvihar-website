# On Cloudflare, set NEXT_PUBLIC_* values as build variables and the secrets with
# `npx wrangler secret put`. For local runs of `npm run start`, put secrets in .dev.vars.
# The database and file storage are the D1 and R2 bindings in wrangler.jsonc.
# Never commit real values.

# Only used by Prisma CLI commands. The running site reads the D1 binding.
DATABASE_URL="file:./local.db"

NEXT_PUBLIC_SITE_URL="https://vastuvihar.org"

# Optional tags. A tag stays off, and is not offered or mentioned in the policy, until
# its ID is set. These are read at build time, so rebuild after changing them.
# Have the policy and notice wording approved before setting any of these in production.
NEXT_PUBLIC_GA4_ID=""                 # Google Analytics, for example G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=""          # Google Ads remarketing, for example AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=""  # Conversion label for a sent enquiry (optional)
NEXT_PUBLIC_META_PIXEL_ID="4516919088573710"          # Meta Pixel, digits only

# Required in production: at least 32 random characters. Keys the hashes in the
# consent ledger. Changing it breaks the link between old records and their contacts.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PRIVACY_HASH_SECRET=""

# Required to enable scheduled retention: at least 32 random characters.
RETENTION_CRON_SECRET=""

# Set to 1 only behind a proxy that sends X-Forwarded-Proto. On Cloudflare, leave this unset
# and turn on "Always Use HTTPS" for the domain instead.
FORCE_HTTPS=""

# Used once by scripts/create-admin-d1.mjs, then removed from the environment.
ADMIN_BOOTSTRAP_PASSWORD=""
