{
  "name": "spaciaz-website",
  "version": "2.0.0",
  "private": true,
  "description": "Spaciaz Demo 5 website with a shared layout and a simplified Next.js project structure.",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild:next": "node scripts/gallery-manifest.mjs",
    "build:next": "next build --webpack",
    "build": "opennextjs-cloudflare build",
    "start": "opennextjs-cloudflare preview",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "export": "node scripts/export.mjs",
    "verify": "node scripts/verify.mjs",
    "postinstall": "prisma generate",
    "cf:migrate": "wrangler d1 migrations apply DB --remote",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:push": "prisma db push",
    "admin:create": "node scripts/create-admin-d1.mjs",
    "test:dpdp": "node scripts/dpdp-compliance-test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-d1": "5.22.0",
    "@prisma/client": "^5.22.0",
    "gsap": "^3.15.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "2.16.0",
    "prisma": "^5.22.0",
    "typescript": "7.0.2",
    "wrangler": "4.157.0"
  }
}
