{
  "name": "spaciaz-website",
  "version": "2.0.0",
  "private": true,
  "description": "Spaciaz Demo 5 website with a shared layout and a simplified Next.js project structure.",
  "scripts": {
    "dev": "next dev --webpack",
    "compress": "node scripts/auto-compress.mjs && node scripts/gallery-manifest.mjs",
    "build:next": "node scripts/gallery-manifest.mjs && next build --webpack",
    "build": "node scripts/gallery-manifest.mjs && prisma generate && next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "cf:build": "node scripts/cf.mjs build local",
    "cf:preview": "node scripts/cf.mjs build local && opennextjs-cloudflare preview",
    "export": "node scripts/export.mjs",
    "verify": "node scripts/verify.mjs",
    "postinstall": "prisma generate",
    "cf:migrate:local": "node scripts/cf.mjs migrate local",
    "db:push": "prisma db push",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:create:d1": "node scripts/create-admin-d1.mjs",
    "test:dpdp": "node scripts/dpdp-compliance-test.mjs",
    "cf:build:production": "node scripts/cf.mjs build production",
    "cf:preflight:production": "node scripts/cf.mjs preflight production",
    "cf:upload:production": "node scripts/cf.mjs upload production --confirm-production",
    "cf:deploy:production": "node scripts/cf.mjs deploy production --confirm-production",
    "cf:migrate:production": "node scripts/cf.mjs migrate production",
    "migrate:export": "node --experimental-sqlite --no-warnings scripts/export-sqlite-to-d1.mjs",
    "migrate:files": "node scripts/upload-files-to-r2.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"scripts/tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-d1": "5.22.0",
    "@prisma/client": "^5.22.0",
    "gsap": "^3.15.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "2.16.0",
    "prisma": "^5.22.0",
    "typescript": "7.0.2",
    "wrangler": "4.157.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "workerd@1.20261103.1": true
  }
}
